<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    android:backgroundTint="#FFF7F6">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/ivProductImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:outlineProvider="none"
            android:adjustViewBounds="true"/>

        <ImageView
            android:id="@+id/ivWishlist"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/ivProductImage"
            android:layout_alignStart="@id/ivProductImage"
            android:layout_margin="8dp"
            android:src="@drawable/ic_wishlist"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/ivProductImage"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Браслет"
                android:textSize="16sp"
                android:textColor="#000000"
                android:fontFamily="@font/merriweather_bold"/>

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450 грн"
                android:textColor="#B22222"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvBeadType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Китайський бісер"
                android:textSize="14sp"
                android:fontFamily="@font/merriweather_regular"
                android:textColor="#707070"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:translationY="-15dp"
            android:layout_marginBottom="30dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_alignEnd="@id/tvBeadType"
            android:layout_alignParentEnd="true"
            android:background="@drawable/red_circle">

            <ImageView
                android:id="@+id/ivAddToCart"
                android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/cart_product"
            android:scaleType="centerInside"/>
        </FrameLayout>


    </RelativeLayout>

</androidx.cardview.widget.CardView>
