<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/adminHomeFragment">

    <fragment
        android:id="@+id/adminHomeFragment"
        android:name="com.example.newfragment.AdminFragment"
        android:label="Адмін панель"
        tools:layout="@layout/fragment_admin">
        <action
            android:id="@+id/action_adminHomeFragment_to_addProductFragment"
            app:destination="@id/addProductFragment" />
        <action
            android:id="@+id/action_adminHomeFragment_to_manageOrdersFragment"
            app:destination="@id/manageOrdersFragment" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.example.newfragment.AddProductFragment"
        android:label="Додати товар"
        tools:layout="@layout/fragment_add_product" />

    <fragment
        android:id="@+id/manageOrdersFragment"
        android:name="com.example.newfragment.ManageOrdersFragment"
        android:label="Керування замовленнями"
        tools:layout="@layout/fragment_manage_orders" />

</navigation>
